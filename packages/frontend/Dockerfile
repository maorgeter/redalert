# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

# Copy workspace manifests (enables npm workspaces dep resolution)
COPY package.json package-lock.json ./
# Create directories to avoid COPY errors if they don't exist yet
RUN mkdir -p packages/backend packages/frontend

COPY packages/backend/package.json  ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/

# Install all workspace deps
RUN npm ci --ignore-scripts

# --- FIX: Copy the entire frontend folder instead of individual files ---
# This prevents "file not found" errors if a config file or 'public' is missing in Git
COPY packages/frontend ./packages/frontend

# NEXT_PUBLIC_* vars are baked into the JS bundle at build time — must be ARGs
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL

WORKDIR /build/packages/frontend

# Build the Next.js app (Assumes output: 'standalone' is in next.config.mjs)
RUN npm run build

# ── Stage 2: Runner ───────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Copy necessary files for standalone execution
COPY --from=builder /build/packages/frontend/package.json ./
COPY --from=builder /build/packages/frontend/.next/standalone ./
COPY --from=builder /build/packages/frontend/.next/static ./.next/static

# Optional: Copy public folder only if it exists to prevent build failure
RUN if [ -d "/build/packages/frontend/public" ]; then cp -r /build/packages/frontend/public ./public; else mkdir ./public; fi

EXPOSE 3000

# Run the standalone server generated by Next.js
CMD ["node", "server.js"]
