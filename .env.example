# ─── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Copy this file to .env and fill in values for local dev.
# On Render, set these as Environment Variables in the dashboard instead.

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001

# Database — local Docker Compose (individual vars)
# On Render, set DATABASE_URL instead (see Render section below)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alertmap
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# ── Ingestion ─────────────────────────────────────────────────────────────────
OREF_INGESTION=true
POLL_INTERVAL_MS=3000

# Simulation — local dev only, NEVER enable in production
MOCK_INGESTION=false
MOCK_EVENT_INTERVAL_MS=8000

# ── Estimation engine ─────────────────────────────────────────────────────────
BUFFER_KM=5
DECAY_MS=300000
RECOMPUTE_INTERVAL_MS=1000

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Frontend (baked at build time — requires rebuild to change) ───────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Optional: MapTiler API key (free tier at maptiler.com)
NEXT_PUBLIC_MAPTILER_KEY=


# ─── RENDER PRODUCTION ────────────────────────────────────────────────────────
# Set these in the Render dashboard (not here).
# Backend service environment variables:
#
#   DATABASE_URL      = <Render internal DB URL — from your PostgreSQL dashboard>
#   DB_SSL            = false
#   PORT              = (set automatically by Render — do not override)
#   NODE_ENV          = production
#   OREF_INGESTION    = true
#   MOCK_INGESTION    = false
#   POLL_INTERVAL_MS  = 3000
#   CORS_ORIGIN       = https://redalert.maorgeter.com
#
# Frontend service environment variables (also injected as Docker build args):
#
#   NEXT_PUBLIC_BACKEND_URL = https://<your-backend-service>.onrender.com
#   NEXT_PUBLIC_WS_URL      = wss://<your-backend-service>.onrender.com
#   NODE_ENV                = production
