# ─── Backend ────────────────────────────────────────────────────────────────
PORT=3001

# Database (PostgreSQL + PostGIS) — optional, system runs without it
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alertmap
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# ── Ingestion sources ────────────────────────────────────────────────────────
# Pikud HaOref public alert API — primary source, enabled by default
OREF_INGESTION=true
POLL_INTERVAL_MS=3000              # Poll interval in ms (3 seconds)

# Simulation adapter — local development only, NEVER enable in production
MOCK_INGESTION=false
MOCK_EVENT_INTERVAL_MS=8000

# ── Estimation engine ─────────────────────────────────────────────────────────
BUFFER_KM=5                        # Buffer radius around official alert polygons (km)
DECAY_MS=300000                    # Zone expiry after last event (ms = 5 min)
RECOMPUTE_INTERVAL_MS=1000         # How often to recompute estimated zones (ms)

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Optional: MapTiler API key for better map tiles (free tier at maptiler.com)
# Without this, falls back to free CARTO dark-matter basemap
NEXT_PUBLIC_MAPTILER_KEY=
